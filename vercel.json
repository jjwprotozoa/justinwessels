{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/about",
      "destination": "/journey",
      "permanent": true
    },
    {
      "source": "/writing",
      "destination": "/evidence",
      "permanent": true
    }
  ]
}
